# ---- Unity generated / machine-local (never commit) ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data: ONLY ignore a .meta if its asset is also ignored.
# (We keep all .meta files under Assets/ — references depend on them.)
!/[Aa]ssets/**/*.meta

# Autogenerated VS / Rider / IDE project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# IDE / editor folders
.vs/
.vscode/
.idea/
.gradle/

# Unity3D generated meta files for ignored types
sysinfo.txt
*.apk
*.aab
*.app
crashlytics-build.properties

# Source asset packages (commit the IMPORTED contents under Assets/ via LFS,
# not the package file). Keep the .unitypackage outside the repo if you want it.
*.unitypackage

# Addressables build cache
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Dev screenshots (editor / MCP captures — not project assets)
/[Aa]ssets/[Ss]creenshots/

# Auto memory written by Claude Code lives outside the repo (~/.claude/...),
# nothing to ignore here — listed only as a reminder.

# New-format solution files (generated)
*.slnx
